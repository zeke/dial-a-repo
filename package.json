    "lint": "eslint ."
  },
  "keywords": ["cloudflare-workers", "voice-agent", "durable-objects", "xai", "github"],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.1"
  }
}
